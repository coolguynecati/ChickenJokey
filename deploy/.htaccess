# Магазин в корне домена: emikashotchicken.ru/ (без /shop/)
# Apache + mod_rewrite

RewriteEngine On

# /shop/... → без /shop/ (только прямой заход в /shop/, не после внутреннего rewrite)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^shop/?$ / [R=301,L]
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^shop/(.+)$ /$1 [R=301,L]

# Не трогаем общие папки
RewriteRule ^images/ - [L]
RewriteRule ^franchise/ - [L]
RewriteRule ^cloud/ - [L]
# Страница медиа: /media → media.html; файлы — из папки media/
RewriteRule ^media$ media.html [L]
RewriteRule ^media/ - [L]

# старые ссылки /media-files/… → папка media/
RewriteRule ^media-files/(.*)$ media/$1 [L]

# Магазин/CRM — всегда из shop/ (старые заглушки в корне не используются)
RewriteRule ^checkout\.html$ shop/checkout.html [L]
RewriteRule ^order-success\.html$ shop/order-success.html [L]
RewriteRule ^crm\.html$ shop/crm.html [L]
RewriteRule ^crm-dymny\.html$ shop/crm-dymny.html [L]
RewriteRule ^contacts\.html$ shop/contacts.html [L]
RewriteRule ^poselok\.html$ shop/poselok.html [L]
RewriteRule ^cloud\.html$ shop/cloud.html [L]
RewriteRule ^emika-api\.js$ shop/emika-api.js [L]
RewriteRule ^emika-guard\.js$ shop/emika-guard.js [L]
RewriteRule ^crm-sw\.js$ shop/crm-sw.js [L]
RewriteRule ^crm-manifest\.webmanifest$ shop/crm-manifest.webmanifest [L]

# остальные файлы из shop/, если нет в корне
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/shop/$1 -f
RewriteRule ^(.+)$ shop/$1 [L]
