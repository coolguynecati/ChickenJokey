PORT=3000
CRM_PASSWORD=change-me-to-strong-password
CRM_PASSWORD_EAT_ARENA=change-me-eat-arena
CRM_PASSWORD_POSELOK=change-me-poselok
CRM_PASSWORD_DYMNY_DVOR=change-me-dymny-dvor

# Письма о заказах Дымный Двор (через запятую — несколько адресов)
DYMNY_ORDER_EMAIL=narek@dimniy-dvor.ru,info@dimniy-dvor.ru

# Google Sheets — журнал заказов (append-only, менеджеры CRM не правят)
# Инструкция: docs/GOOGLE_SHEETS.md
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Журнал заказов
GOOGLE_SHEETS_BRANDS=dymny-dvor
# Вариант A: весь JSON ключа service account одной строкой
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
# Вариант B: email + ключ отдельно
# GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-bot@PROJECT.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Еженедельный Excel на почту (по умолчанию Пн 09:00 МСК → narek@dimniy-dvor.ru)
WEEKLY_EXPORT_EMAIL=narek@dimniy-dvor.ru
WEEKLY_EXPORT_BRAND=dymny-dvor
# WEEKLY_EXPORT_DISABLED=true
# Секрет для ручного/cron запуска: POST /api/cron/weekly-export
CRON_SECRET=change-me-cron-secret

# Поддомен CRM Дымного двора: https://crm.dimniy-dvor.ru/ сразу открывает кабинет
CRM_DYMNY_HOST=crm.dimniy-dvor.ru

# Письма о новых заказах (точка + info@emikashotchicken.ru)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@emikashotchicken.ru
SMTP_PASS=your-smtp-password
SMTP_FROM=orders@emikashotchicken.ru
# Публичный URL сайта (логотип и картинки в письмах гостю)
PUBLIC_SITE_URL=https://emikashotchicken.ru
# ORDER_NOTIFY_DISABLED=true

# Push в CRM (Android / PWA). Сгенерировать: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@emikashotchicken.ru
